\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Routing probe (Gate 4: preregistered null, oracle headroom)}{8}{subsection.5.4}\protected@file@percent }
\newlabel{sec:empirical:routing}{{5.4}{8}{Routing probe (Gate 4: preregistered null, oracle headroom)}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Routing probe: Oracle (per-cell best-model picker) vs. Scenario Router vs. the 10 always-$m$ static baselines. The scenario router ties the best static baseline (DeepSeek-V3, blue dashed line) and fails the preregistered $\Delta \geq 0.02$ uplift criterion. The $+0.239$ oracle-to-static gap indicates substantial per-query headroom that scenario-only features cannot exploit; closing this gap is the design target for the v0.3 deconvolution router (\S  \ref {sec:future}).}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:routing}{{2}{8}{Routing probe: Oracle (per-cell best-model picker) vs. Scenario Router vs. the 10 always-$m$ static baselines. The scenario router ties the best static baseline (DeepSeek-V3, blue dashed line) and fails the preregistered $\Delta \geq 0.02$ uplift criterion. The $+0.239$ oracle-to-static gap indicates substantial per-query headroom that scenario-only features cannot exploit; closing this gap is the design target for the v0.3 deconvolution router (\S \ref {sec:future})}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}The RLHF paradox in $S_M$ space}{8}{subsection.5.5}\protected@file@percent }
\newlabel{sec:empirical:paradox}{{5.5}{8}{The RLHF paradox in $S_M$ space}{subsection.5.5}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Architecture-dependent behavioral ceiling and cross-architecture clustering}{9}{subsection.5.6}\protected@file@percent }
\newlabel{sec:empirical:arch}{{5.6}{9}{Architecture-dependent behavioral ceiling and cross-architecture clustering}{subsection.5.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Model behavioral fingerprints in 2D MDS space, computed from pairwise cosine distances over the cross-scenario $S_M$ vectors of Table~\ref {tab:bench1}. Colors indicate architecture family. Models cluster by behavioral pattern rather than by vendor or architecture: the tightest pair (DeepSeek-V3, Opus 4.6) crosses MoE/Dense boundaries at cosine distance $0.002$.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:fingerprints}{{3}{9}{Model behavioral fingerprints in 2D MDS space, computed from pairwise cosine distances over the cross-scenario $S_M$ vectors of Table~\ref {tab:bench1}. Colors indicate architecture family. Models cluster by behavioral pattern rather than by vendor or architecture: the tightest pair (DeepSeek-V3, Opus 4.6) crosses MoE/Dense boundaries at cosine distance $0.002$}{figure.3}{}}
